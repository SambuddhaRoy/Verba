{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Verba",
  "version": "0.3.1",
  "identifier": "dev.verba.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "overlay",
        "title": "Verba",
        "url": "overlay.html",
        "width": 760,
        "height": 420,
        "center": false,
        "x": 0,
        "y": 0,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "visible": false,
        "shadow": false
      },
      {
        "label": "onboard",
        "title": "Welcome to Verba",
        "url": "onboard.html",
        "width": 720,
        "height": 620,
        "center": true,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "visible": false,
        "shadow": true,
        "windowEffects": {
          "effects": ["acrylic", "blur"],
          "state": "active"
        }
      },
      {
        "label": "settings",
        "title": "Verba — Settings",
        "url": "settings.html",
        "width": 940,
        "height": 660,
        "minWidth": 820,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "visible": false,
        "shadow": true,
        "windowEffects": {
          "effects": ["acrylic", "blur"],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "msi",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico", "icons/icon.png"]
  }
}
